                _upd_rows = [tuple(r[c] for c in _upd_set_cols + _upd_key_cols) for r in df_write.collect()]
                lib.batch_update(spark, conn_target, "{{ table_name }}", _upd_set_cols, _upd_key_cols, _upd_rows, 1000)
        {% endif %}
        # No rows to insert (all rows were updated)
        df_write = df_write.filter(lit(False))
        {% else %}
        # Dynamic field strategy — split by _update_flag operation (INSERT/UPDATE/DELETE)
        _df_ins = df_write.filter(col("_update_flag") == "I").drop("_update_flag")
        _df_upd = df_write.filter(col("_update_flag") == "U").drop("_update_flag")
        _df_del = df_write.filter(col("_update_flag") == "D").drop("_update_flag")
        df_write = df_write.drop("_update_flag")
        # DELETE: composite key batch delete (all key columns together)
        {% if _upd_keys %}
        _del_key_cols = {{ _upd_keys }}
        if not _df_del.rdd.isEmpty():
            _del_rows = [tuple(r[c] for c in _del_key_cols) for r in _df_del.select(*_del_key_cols).distinct().collect()]
            if _del_rows:
                lib.batch_delete_composite(spark, conn_target, "{{ table_name }}", _del_key_cols, _del_rows, 1000)
        {% endif %}
        # UPDATE: batch update via JDBC
        {% if _upd_keys %}
        if not _df_upd.rdd.isEmpty():
            _upd_key_cols = {{ _upd_keys }}
            _upd_set_cols = [c for c in _df_upd.columns if c.lower() not in [k.lower() for k in _upd_key_cols]]
            if _upd_set_cols:
                _upd_rows = [tuple(r[c] for c in _upd_set_cols + _upd_key_cols) for r in _df_upd.collect()]
                lib.batch_update(spark, conn_target, "{{ table_name }}", _upd_set_cols, _upd_key_cols, _upd_rows, 1000)
        {% endif %}
        # INSERT — set df_write to _df_ins so it flows through normal write path
        df_write = _df_ins
        {% endif %}
        {% endif %}
        {% if is_delete and delete_keys %}
        # Static DD_DELETE: composite primary-key delete of all rows
        _del_key_cols = {{ delete_keys }}
        if not df_write.rdd.isEmpty():
            _del_rows = [tuple(r[c] for c in _del_key_cols) for r in df_write.select(*_del_key_cols).distinct().collect()]
            if _del_rows:
                lib.batch_delete_composite(spark, conn_target, "{{ table_name }}", _del_key_cols, _del_rows, 1000)
        {% else %}
        {% if unmapped_columns %}
        # Add NULL for unmapped target columns (schema parity) - excluding identity columns
        {% for col in unmapped_columns %}
        {% if col.lower() not in ['src_rowid'] %}
        df_write = df_write.withColumn("{{ col }}", lit(None).cast(StringType()))
        {% endif %}
        {% endfor %}
        {% endif %}
        {% if target_columns %}
        # Select only target-defined columns (field_map already handled name alignment)
        _target_cols = {{ target_columns }}
        df_write = df_write.select(*[col for col in _target_cols if col.lower() in [x.lower() for x in df_write.columns]])
        {% endif %}
        {% if sink_type == 'csv' %}
        # Write to flat file — prefer config.yml objects metadata, then derived default path
        _write_obj = objects.get("{{ table_name }}")
        if _write_obj and isinstance(_write_obj, dict):
            _write_path = _write_obj.get('path', '/tmp/{{ table_name }}')
            _write_fmt = _write_obj.get('format', '{{ sink_type }}')
        # Runtime fallback: skip write if path resolves to /dev/null
        if _write_path and _write_path.strip() in ("/dev/null", "NUL"):
            logger.info("Target %s resolved to /dev/null, skipping write", "{{ step.step_name }}")
        else:
            lib.write_file(df_write, _write_path, format=_write_fmt, mode="overwrite")
        {% else %}
        # Write to database table (Oracle, etc.) using write_table (supports smart repartition, batch size, empty-df skip)
        lib.write_table(df_write, conn_target, "{{ table_name }}", mode="{{ mode }}")
        {% endif %}
        {% endif %}
        {% endif %}

        logger.info("{{ step.step_name }} write completed")
        {% elif step.step_type == IRStepType.WORKFLOW_DAG %}
        # Workflow DAG step - handled by orchestration
        pass
        {% endif %}
        {% if step.warnings %}
        {% for warning in step.warnings %}
        # WARNING: {{ warning }}
        metrics.add_warning("{{ warning }}")
        {% endfor %}
        {% endif %}
        {% endfor %}
        
        {% if session_sqls %}
        # Session Post-SQL after the pipeline succeeds
        if session_sqls and session_sqls.get("post_sql"):
            for _stmt in [s.strip() for s in session_sqls["post_sql"].split(";") if s.strip()]:
                logger.info("Session Post-SQL: %s", _stmt[:150])
                lib.execute_sql(spark, conn_target, _stmt)
        {% endif %}
        metrics.complete()
        logger.info("Mapping {{ mapping_name }} completed: SUCCESS")
        return True
        
    except Exception as e:
        metrics.fail(e)
        logger.error(f"Mapping {{ mapping_name }} FAILED: {e}", exc_info=True)
        return False


def main():
    """Standalone execution entry point."""
    lib.init_logger()
    logger = lib.get_logger()
    config = lib.load_config('env/config.yml')
    spark = lib.get_spark_session("{{ mapping_name }}", config)
    ctx = lib.SparkContext(spark)
    metrics = lib.MappingMetrics("{{ mapping_name }}")
    
    try:
        success = run_mapping(ctx, metrics)
        if success:
            lib._flush_pending_passwords()
        if not success:
            # Exit the JVM non-zero so YARN marks the application FAILED.
            # In client mode the AM lives in this JVM: a normal spark.stop() +
            # python exit code still reports SUCCEEDED (AM exits cleanly).
            spark.sparkContext._jvm.System.exit(1)
        return 0
    finally:
        spark.stop()


if __name__ == "__main__":
    # sys.exit propagates the failure exit code — without it the process exits 0
    # and YARN reports SUCCEEDED even when the mapping failed.
    import sys as _sys
    _sys.exit(main())
