        {% elif step.step_type == IRStepType.APPLY_AGGREGATOR %}
        # Aggregator: {{ step.step_name }}
        {% set group_by = step.params.get('group_by', []) %}
        {% set aggs = step.params.get('aggregations', {}) %}
        {% set agg_selects = step.params.get('agg_selects', []) %}
        {% set agg_literals = step.params.get('agg_literals', []) %}
        {% if group_by and aggs %}
        {% if agg_selects or agg_literals %}
        # Select only mapped upstream columns with correct port names
        _agg_input = {{ step.df_input }}.select(
            {% for s in agg_selects %}
            {% if s.from in ('__null__', 'DUMMY') %}
            lit(None).alias("{{ s.to }}"){% if not loop.last %},{{ '\n' }}{% endif %}
            {% elif s.from == s.to %}
            col("{{ s.from }}"){% if not loop.last %},{{ '\n' }}{% endif %}
            {% else %}
            col("{{ s.from }}").alias("{{ s.to }}"){% if not loop.last %},{{ '\n' }}{% endif %}
            {% endif %}
            {% endfor %}
            {%- if agg_selects and agg_literals %},{{ '\n' }}{% endif %}
            {% for l in agg_literals %}
            expr("{{ l.expression }}").alias("{{ l.name }}"){% if not loop.last %},{{ '\n' }}{% endif %}
            {% endfor %}
        )
        {{ step.df_output }} = _agg_input.groupBy({{ group_by | map('tojson') | join(', ') }})
        {% else %}
        {{ step.df_output }} = {{ step.df_input }}.groupBy({{ group_by | map('tojson') | join(', ') }})
        {% endif %}
        {{ step.df_output }} = {{ step.df_output }}.agg(
            {% for col_name, agg_expr in aggs.items() %}
            {{ agg_expr }}.alias("{{ col_name }}"){{ "," if not loop.last else "" }}
            {% endfor %}
        )
        {% elif group_by and not aggs %}
        {#- GROUP BY with no aggregations → equivalent to DISTINCT #}
        {% if agg_selects %}
        {{ step.df_output }} = {{ step.df_input }}.select(
            {% for s in agg_selects %}
            {% if s.from in ('__null__', 'DUMMY') %}
            lit(None).alias("{{ s.to }}"){% if not loop.last %},{{ '\n' }}{% endif %}
            {% elif s.from == s.to %}
            col("{{ s.from }}"){% if not loop.last %},{{ '\n' }}{% endif %}
            {% else %}
            col("{{ s.from }}").alias("{{ s.to }}"){% if not loop.last %},{{ '\n' }}{% endif %}
            {% endif %}
            {% endfor %}
        ).distinct()
        {% else %}
        {{ step.df_output }} = {{ step.df_input }}.select({% for c in group_by %}"{{ c }}"{% if not loop.last %}, {% endif %}{% endfor %}).distinct()
        {% endif %}
        {% else %}
        {{ step.df_output }} = {{ step.df_input }}
        {% endif %}
        ctx.register_df("{{ step.df_output }}", {{ step.df_output }})
        
        {% elif step.step_type == IRStepType.APPLY_SORTER %}
        # Sorter: {{ step.step_name }}
        {% set srtcfg = step.params['sorter_cfg'] %}
        {{ step.df_output }} = lib.sorter(
            input_df={{ step.df_input }},
            {% if srtcfg.get('rename_columns') %}
            rename_columns=[
                {{ srtcfg['rename_columns'] | map('pyrepr') | join(',\n                ') }}
            ],
            {% endif %}
            {% if srtcfg.get('sort_columns') %}
            sort_columns=[
                {{ srtcfg['sort_columns'] | map('pyrepr') | join(',\n                ') }}
            ],
            {% endif %}
        )
        ctx.register_df("{{ step.df_output }}", {{ step.df_output }})
        
        {% elif step.step_type == IRStepType.APPLY_UNION %}
        # Union: {{ step.step_name }}
        {% set uncfg = step.params['union_cfg'] %}
        {{ step.df_output }} = lib.union(
            input_df={{ step.df_input }},
            {% if uncfg.get('union_selects') %}
            union_selects=[
            {% for _us in uncfg['union_selects'] %}
                {'df_input': {{ _us['df_input'] }}, 'selects': [
                    {{ _us['selects'] | map('pyrepr') | join(',\n                    ') }}
                ]},
            {% endfor %}
            ],
            {% else %}
            inputs=[{% for _df in uncfg.get('inputs', []) %}{{ _df }}{% if not loop.last %}, {% endif %}{% endfor %}],
            {% endif %}
            {% if uncfg.get('flag_column') %}
            flag_column={{ uncfg['flag_column'] | pyrepr }},
            {% endif %}
            {% if uncfg.get('output_columns') %}
            output_columns={{ uncfg['output_columns'] | pyrepr }},
            {% endif %}
        )
        ctx.register_df("{{ step.df_output }}", {{ step.df_output }})
        
        {% elif step.step_type == IRStepType.APPLY_ROUTER %}
        # Router: {{ step.step_name }} - splits into multiple output groups
        {% set rtrcfg = step.params['router_cfg'] %}
        _rtr = lib.router(
            {% if not rtrcfg.get('multi_feed') %}
            input_df={{ step.df_input }},
            {% endif %}
            {% if rtrcfg.get('multi_feed') %}
            multi_feed=True,
            feeds=[
            {% for _df, _aliases in rtrcfg['feeds'] %}
                ({{ _df }}, {{ _aliases | pyrepr }}),
            {% endfor %}
            ],
            {% endif %}
            groups=[
            {%- for _g in rtrcfg['groups'] %}
                {
                    'name': {{ _g['name'] | pyrepr }},
                    'df_output': {{ _g['df_output'] | pyrepr }},
                    {%- if _g.get('condition') %}
                    'condition': {{ _g['condition'] | pyrepr }},
                    {%- endif %}
                    {%- if _g.get('default_negated') %}
                    'default_negated': {{ _g['default_negated'] | pyrepr }},
                    {%- endif %}
                    {%- if _g.get('renames') %}
                    'renames': [
                    {%- for _r in _g['renames'] %}
                        {{ _r | pyrepr }},
                    {%- endfor %}
                    ],
                    {%- endif %}
                },
            {%- endfor %}
            ],
            {% if rtrcfg.get('substitutions') %}
            substitutions={{ '{' }}{% for _k, _v in rtrcfg['substitutions'].items() %}'{{ _k }}': {{ _v }}{% if not loop.last %}, {% endif %}{% endfor %}{{ '}' }},
            {% endif %}
        )
        {% for _g in rtrcfg['groups'] %}
        {{ _g['df_output'] }} = _rtr[{{ _g['df_output'] | pyrepr }}]
        ctx.register_df("{{ _g['df_output'] }}", {{ _g['df_output'] }})
        {% endfor %}

        {% elif step.step_type == IRStepType.APPLY_SEQUENCE %}
        # Sequence Generator: {{ step.step_name }}
        {% set seqcfg = step.params['sequence_cfg'] %}
        {{ step.df_output }} = lib.sequence(
            input_df={{ step.df_input }},
            output_col={{ seqcfg.get('output_col', 'NEXTVAL') | pyrepr }},
            start={{ seqcfg.get('start', 1) | pyrepr }},
        )
        ctx.register_df("{{ step.df_output }}", {{ step.df_output }})

        {% elif step.step_type == IRStepType.APPLY_NORMALIZER %}
        # Normalizer: {{ step.step_name }}
        # Expands repeating fields into multiple rows with a 1-based sequence key
        {% set pass_cols = step.params.get('passthrough_cols', []) %}
        {% set nrm_groups = step.params.get('normalizer_fields', []) %}
        {% set key_name = step.params.get('key_name', 'GENERATED_KEY') %}
        {% if nrm_groups | length == 1 %}
        {#- Single repeating group: use posexplode #}
        {% set g = nrm_groups[0] %}
        {{ step.df_output }} = {{ step.df_input }}.select(
            {% for c in pass_cols %}"{{ c.name }}"{% if not loop.last or true %}, {% endif %}{% endfor %}
            posexplode(array({{ g.members | map('tojson') | join(', ') }})).alias("{{ key_name }}", "{{ g.base_name }}")
        )
        # Make GENERATED_KEY 1-based and drop NULL rows
        {{ step.df_output }} = {{ step.df_output }}.withColumn(
            "{{ key_name }}", col("{{ key_name }}") + 1
        ).filter(
            col("{{ g.base_name }}").isNotNull()
        )
        {% elif nrm_groups | length > 1 %}
        {#- Multiple groups: use arrays_zip to align indices across groups #}
        {{ step.df_output }} = {{ step.df_input }}.select(
            {% for c in pass_cols %}"{{ c.name }}"{% if not loop.last %}, {% endif %}{% endfor %}
            {% if pass_cols %}, {% endif %}
            posexplode(arrays_zip(
            {%- for g in nrm_groups %}
                array({{ g.members | map('tojson') | join(', ') }}){{ "," if not loop.last else "" }}
            {%- endfor %}
            )).alias("{{ key_name }}", "_nrm_zip")
        )
        # Make GENERATED_KEY 1-based and drop NULL rows
        {% set last_idx = (nrm_groups | length) - 1 %}
        {% for g in nrm_groups %}
        {{ step.df_output }} = {{ step.df_output }}.withColumn("{{ g.base_name }}", col("_nrm_zip")["{{ loop.index0 }}"])
        {% endfor %}
        {{ step.df_output }} = {{ step.df_output }}.withColumn(
            "{{ key_name }}", col("{{ key_name }}") + 1
        ).filter(
            col("_nrm_zip").isNotNull()
        ).drop("_nrm_zip")
        {% else %}
        {{ step.df_output }} = {{ step.df_input }}
        {% endif %}
        ctx.register_df("{{ step.df_output }}", {{ step.df_output }})

        {% elif step.step_type == IRStepType.APPLY_RANK %}
        # Rank: {{ step.step_name }}
        {% set group_by = step.params.get('group_by', []) %}
        {% set rank_expr = step.params.get('rank_expression', '') %}
        {% set rank_port = step.params.get('rank_port_name', 'RANKINDEX') %}
        {% set top_n = step.params.get('top_n', 1) %}
        {% set sort_dir = step.params.get('sort_direction', 'DESC') %}
        {% set rank_func = step.params.get('rank_function', 'dense_rank') %}
        {% set mvars = step.params.get('mapping_variables', {}) %}
        {% if rank_expr %}
        {{ step.df_output }} = {{ step.df_input }}.withColumn("_rank_val", expr({{ rank_expr | tojson }}))
        {% else %}
        {{ step.df_output }} = {{ step.df_input }}
        {% endif %}
        {% if group_by %}
        _window_{{ step.df_output }} = Window.partitionBy({% for c in group_by %}"{{ c }}"{% if not loop.last %}, {% endif %}{% endfor %})
        {% if sort_dir == "DESC" %}
        _window_{{ step.df_output }} = _window_{{ step.df_output }}.orderBy(desc("{{ rank_port if not rank_expr else '_rank_val' }}"))
        {% else %}
        _window_{{ step.df_output }} = _window_{{ step.df_output }}.orderBy(asc("{{ rank_port if not rank_expr else '_rank_val' }}"))
        {% endif %}
        {{ step.df_output }} = {{ step.df_output }}.withColumn("{{ rank_port }}",
            {{ rank_func }}().over(_window_{{ step.df_output }})
        )
        {{ step.df_output }} = {{ step.df_output }}.filter(col("{{ rank_port }}") <= {{ top_n }})
        {% endif %}
        {% if rank_expr %}
        {#- Drop the temporary _rank_val column #}
        {{ step.df_output }} = {{ step.df_output }}.drop("_rank_val")
        {% endif %}
        ctx.register_df("{{ step.df_output }}", {{ step.df_output }})

        {% elif step.step_type == IRStepType.APPLY_TRANSACTION_CONTROL %}
        # Transaction Control: {{ step.step_name }}
        # No-op in PySpark — Spark manages transactions at the batch level.
        # Original control expression: {{ step.params.get('control_expression', '(none)') }}
        {{ step.df_output }} = {{ step.df_input }}
        ctx.register_df("{{ step.df_output }}", {{ step.df_output }})

        {% elif step.step_type == IRStepType.APPLY_UPDATE_STRATEGY %}
        # Update Strategy: {{ step.step_name }}
        # Strategy: {{ step.params.get('strategy_expression', 'DD_INSERT') }}
        {% set uscfg = step.params.get('update_strategy_cfg', {}) %}
        {{ step.df_output }} = lib.update_strategy(
            input_df={{ step.df_input }},
            {% if uscfg.get('strategy_field') %}
            strategy_field={{ uscfg['strategy_field'] | pyrepr }},
            {% endif %}
        )
        ctx.register_df("{{ step.df_output }}", {{ step.df_output }})
        
        {% elif step.step_type == IRStepType.EXECUTE_SQL %}
        # Execute SQL: {{ step.step_name }} ({{ step.params.get('sql_type', 'pre') }}-SQL)
        lib.execute_sql(spark, conn_target, """{{ step.params.get('sql_statement', '') }}""")
        
        {% elif step.step_type == IRStepType.MERGE_DELTA %}
        # Merge into Delta: {{ step.step_name }}
        {% set merge_keys = step.params.get('merge_keys', []) %}
        {% if step.params.get('has_update_flag', False) %}
        merge_with_update_flag(
            spark, {{ step.df_input }},
            "{{ step.params.get('target_table', 'target') }}",
            {{ merge_keys }}
        )
        {% else %}
        merge_into_delta(
            spark, {{ step.df_input }},
            "{{ step.params.get('target_table', 'target') }}",
            {{ merge_keys }}
        )
        {% endif %}
        
        {% elif step.step_type == IRStepType.WRITE_TARGET %}
        # Write to Target: {{ step.step_name }}
        {% set wtcfg = step.params['write_target_cfg'] %}
        lib.write_target(
            spark=spark,
            df={{ step.df_input }},
            conn=conn_target,
            table={{ wtcfg['table'] | pyrepr }},
            mode={{ wtcfg['mode'] | pyrepr }},
            {% if wtcfg.get('sink_type') != 'delta' %}
            sink_type={{ wtcfg['sink_type'] | pyrepr }},
            {% endif %}
            {% if wtcfg.get('target_columns') %}
            source_columns=[
                {{ wtcfg['source_columns'] | map('pyrepr') | join(',\n                ') }},
            ],
            target_columns=[
                {{ wtcfg['target_columns'] | map('pyrepr') | join(',\n                ') }},
            ],
            {% endif %}
            {% if wtcfg.get('is_delete') %}
            is_delete=True,
            {% endif %}
            {% if wtcfg.get('delete_keys') %}
            delete_keys={{ wtcfg['delete_keys'] | pyrepr }},
            {% endif %}
            {% if wtcfg.get('cast_nulltype') %}
            cast_nulltype=True,
            {% endif %}
            {% if wtcfg.get('has_update_flag') %}
            has_update_flag=True,
            {% endif %}
            {% if wtcfg.get('static_dd') %}
            static_dd={{ wtcfg['static_dd'] | pyrepr }},
            {% endif %}
            config=config,
        )

        logger.info("{{ step.step_name }} write completed")
        {% elif step.step_type == IRStepType.WORKFLOW_DAG %}
        # Workflow DAG step - handled by orchestration
        pass
        {% endif %}
        {% if step.warnings %}
        {% for warning in step.warnings %}
        # WARNING: {{ warning }}
        metrics.add_warning("{{ warning }}")
        {% endfor %}
        {% endif %}
        {% endfor %}
        
        {% if session_sqls %}
        # Session Post-SQL after the pipeline succeeds
        if session_sqls and session_sqls.get("post_sql"):
            for _stmt in [s.strip() for s in session_sqls["post_sql"].split(";") if s.strip()]:
                logger.info("Session Post-SQL: %s", _stmt[:150])
                lib.execute_sql(spark, conn_target, _stmt)
        {% endif %}
        metrics.complete()
        logger.info("Mapping {{ mapping_name }} completed: SUCCESS")
        return True
        
    except Exception as e:
        metrics.fail(e)
        logger.error(f"Mapping {{ mapping_name }} FAILED: {e}", exc_info=True)
        return False


def main():
    """Standalone execution entry point."""
    lib.init_logger()
    logger = lib.get_logger()
    config = lib.load_config('env/config.yml')
    spark = lib.get_spark_session("{{ mapping_name }}", config)
    ctx = lib.SparkContext(spark)
    metrics = lib.MappingMetrics("{{ mapping_name }}")
    
    try:
        success = run_mapping(ctx, metrics)
        if success:
            lib._flush_pending_passwords()
        if not success:
            # Exit the JVM non-zero so YARN marks the application FAILED.
            # In client mode the AM lives in this JVM: a normal spark.stop() +
            # python exit code still reports SUCCEEDED (AM exits cleanly).
            spark.sparkContext._jvm.System.exit(1)
        return 0
    finally:
        spark.stop()


if __name__ == "__main__":
    # sys.exit propagates the failure exit code — without it the process exits 0
    # and YARN reports SUCCEEDED even when the mapping failed.
    import sys as _sys
    _sys.exit(main())
