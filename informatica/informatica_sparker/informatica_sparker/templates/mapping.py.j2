        # DD_DELETE: Delete matching rows from target table by key field(s)
        for _dk in {{ delete_keys }}:
            _dk_lower = _dk.lower()
            if _dk_lower in [c.lower() for c in df_write.columns]:
                _del_vals = [r for r in df_write.select(col(_dk_lower)).distinct().rdd.flatMap(lambda x: x).collect() if r is not None]
                if _del_vals:
                    lib.batch_delete(spark, conn_target, "{{ table_name }}", _dk, _del_vals, 1000)
        {% else %}
        # Cast columns to match target schema data types
        {% for col_name, col_type in target_column_types.items() %}
        {% set col_lower = col_name.lower() %}
        {% if col_type and col_type.upper().startswith('VARCHAR') or col_type and col_type.upper().startswith('NVARCHAR') or col_type and col_type.upper() == 'STRING' or col_type and col_type.upper().startswith('CHAR') %}
        if "{{ col_lower }}" in [c.lower() for c in df_write.columns]:
            for c in df_write.columns:
                if c.lower() == "{{ col_lower }}":
                    df_write = df_write.withColumn(c,
                        when(col(c).cast(DecimalType(38,0)).isNotNull(),
                             col(c).cast(DecimalType(38,0)).cast(StringType()))
                        .otherwise(col(c).cast(StringType())))
        {% elif col_type and col_type.upper() in ['INTEGER', 'INT', 'BIGINT', 'SMALLINT', 'TINYINT'] %}
        if "{{ col_lower }}" in [c.lower() for c in df_write.columns]:
            for c in df_write.columns:
                if c.lower() == "{{ col_lower }}":
                    df_write = df_write.withColumn(c, col(c).cast(LongType()))
        {% elif col_type and ('DECIMAL' in col_type.upper() or 'NUMERIC' in col_type.upper()) %}
        if "{{ col_lower }}" in [c.lower() for c in df_write.columns]:
            for c in df_write.columns:
                if c.lower() == "{{ col_lower }}":
                    df_write = df_write.withColumn(c, col(c).cast(DecimalType(38, 10)))
        {% elif col_type and col_type.upper() in ['FLOAT', 'DOUBLE', 'REAL'] %}
        if "{{ col_lower }}" in [c.lower() for c in df_write.columns]:
            for c in df_write.columns:
                if c.lower() == "{{ col_lower }}":
                    df_write = df_write.withColumn(c, col(c).cast(DoubleType()))
        {% elif col_type and col_type.upper() in ['DATE'] %}
        if "{{ col_lower }}" in [c.lower() for c in df_write.columns]:
            for c in df_write.columns:
                if c.lower() == "{{ col_lower }}":
                    df_write = df_write.withColumn(c, col(c).cast(DateType()))
        {% elif col_type and col_type.upper() in ['DATETIME', 'TIMESTAMP', 'DATETIME2'] %}
        if "{{ col_lower }}" in [c.lower() for c in df_write.columns]:
            for c in df_write.columns:
                if c.lower() == "{{ col_lower }}":
                    df_write = df_write.withColumn(c, col(c).cast(TimestampType()))
        {% endif %}
        {% endfor %}
        {% if unmapped_columns %}
        # Add NULL for unmapped target columns (schema parity) - excluding identity columns
        {% for col in unmapped_columns %}
        {% if col.lower() not in ['src_rowid'] %}
        df_write = df_write.withColumn("{{ col }}", lit(None).cast(StringType()))
        {% endif %}
        {% endfor %}
        {% endif %}
        {% if target_columns %}
        # Map source columns to target columns using connector field map (handles name mismatches)
        {% set field_map = step.params.get('field_map', {}) %}
        {% if field_map %}
        _field_map = {{ field_map | tojson }}
        for _tgt_col, _src_col in _field_map.items():
            if _tgt_col not in df_write.columns and _src_col in df_write.columns:
                df_write = df_write.withColumnRenamed(_src_col, _tgt_col)
        {% endif %}
        # Select only target-defined columns (field_map already handled name alignment)
        _target_cols = {{ target_columns }}
        df_write = df_write.select(*[col for col in _target_cols if col in df_write.columns])
        {% endif %}
        {% if sink_type == 'csv' %}
        # Write to flat file — prefer config.yml objects metadata, then derived default path
        _write_obj = objects.get("{{ table_name }}")
        if _write_obj and isinstance(_write_obj, dict):
            _write_path = _write_obj.get('path', '/tmp/{{ table_name }}')
            _write_fmt = _write_obj.get('format', '{{ sink_type }}')
        # Runtime fallback: skip write if path resolves to /dev/null
        if _write_path and _write_path.strip() in ("/dev/null", "NUL"):
            logger.info("Target %s resolved to /dev/null, skipping write", "{{ step.step_name }}")
        else:
            lib.write_file(df_write, _write_path, format=_write_fmt, mode="overwrite")
        {% else %}
        # Write to database table (Oracle, etc.) using write_table (supports smart repartition, batch size, empty-df skip)
        lib.write_table(df_write, conn_target, "{{ table_name }}", mode="{{ mode }}")
        {% endif %}
        {% endif %}
        {% endif %}

        logger.info("{{ step.step_name }} write completed")
        {% elif step.step_type == IRStepType.WORKFLOW_DAG %}
        # Workflow DAG step - handled by orchestration
        pass
        {% endif %}
        {% if step.warnings %}
        {% for warning in step.warnings %}
        # WARNING: {{ warning }}
        metrics.add_warning("{{ warning }}")
        {% endfor %}
        {% endif %}
        {% endfor %}
        
        metrics.complete()
        logger.info("Mapping {{ mapping_name }} completed: SUCCESS")
        return True
        
    except Exception as e:
        metrics.fail(e)
        logger.error(f"Mapping {{ mapping_name }} FAILED: {e}", exc_info=True)
        return False


def main():
    """Standalone execution entry point."""
    lib.init_logger()
    logger = lib.get_logger()
    config = lib.load_config('env/config.yml')
    spark = lib.get_spark_session("{{ mapping_name }}", config)
    ctx = lib.SparkContext(spark)
    metrics = lib.MappingMetrics("{{ mapping_name }}")
    
    try:
        success = run_mapping(ctx, metrics)
        if success:
            lib._flush_pending_passwords()
        return 0 if success else 1
    finally:
        spark.stop()


if __name__ == "__main__":
    main()
