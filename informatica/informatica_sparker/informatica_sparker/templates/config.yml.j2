# Configuration for PySpark Job
# Auto-generated by ASL Informatica XML to PySpark Converter
# Generated from: {{ mapping_name }}

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
environment:
  name: ${ENV_NAME:development}
  log_level: ${LOG_LEVEL:INFO}
  
# =============================================================================
# SPARK CONFIGURATION
# =============================================================================
# Select which Spark connection profile to use:
#   spark_local      - local[*] mode, no cluster deps
#   spark3_client    - YARN client mode (spark3 kerberos + executor PYTHONPATH)
#   spark3_on_yarn   - YARN cluster mode (spark3 kerberos + executor PYTHONPATH)
spark:
  app_name: "{{ mapping_name }}"
  # CDP Spark home — used at runtime to load the matching pyspark before any
  # pyspark import (see bootstrap block at the top of generated m_*.py).
  home: "/opt/cloudera/parcels/SPARK3-3.5.4.3.5.7191000.0-30-1.p0.68499982/lib/spark3"
  connection: ${SPARK_CONNECTION:spark3_client}
  master: ${SPARK_MASTER:yarn}
  # Common spark config shared across all profiles (profile-specific overrides below)
  config:
    spark.ui.port: "4040"
    spark.driver.memory: "4g"
    spark.executor.memory: "4g"
    spark.sql.shuffle.partitions: "50"
    spark.default.parallelism: "50"
    spark.sql.debug.maxToStringFields: "100"
    spark.driver.maxResultSize: "4g"
    spark.sql.autoBroadcastJoinThreshold: "-1"
    spark.memory.fraction: "0.8"
    spark.memory.storageFraction: "0.3"
    spark.dynamicAllocation.enabled: "true"
    spark.shuffle.service.enabled: "true"
    spark.sql.adaptive.enabled: "true"
    spark.driver.extraClassPath: "/opt/cloudera/parcels/SPARK3-3.5.4.3.5.7191000.0-30-1.p0.68499982/lib/spark3/jars/ojdbc8.jar"
    spark.hadoop.hadoop.security.credential.provider.path: "jceks://file/$(pwd)/env/passwords.jceks"

# =============================================================================
# CREDENTIAL PROVIDER
# =============================================================================
# Passwords support Hadoop CredentialProvider for encryption.
# Set password to "credential:<alias>" to use a stored credential.
# 
# Create credentials (run once before first execution):
#   hadoop credential create connections.oracle.password -provider jceks://file/$(pwd)/env/passwords.jceks

# =============================================================================
# SPARK CONNECTION PROFILES
# =============================================================================
# Profile config merges on top of spark.config (spark.config values can be overridden per profile).
spark_connections:
  spark_local:
    master: "local[*]"
    config: {}

  spark3_client:
    master: "yarn"
    deploy-mode: "client"
    config:
      spark.kerberos.keytab: "/appl/hadoop/cdp/keytabs/etl_user.keytab"
      spark.kerberos.principal: "etl_user@AIDA.COM"
      spark.executorEnv.PYTHONPATH: "/opt/cloudera/parcels/SPARK3/lib/spark3/python:/opt/cloudera/parcels/SPARK3/lib/spark3/python/lib/py4j-0.10.9.7-src.zip"

  spark3_on_yarn:
    master: "yarn"
    deploy-mode: "cluster"
    config:
      spark.kerberos.keytab: "/appl/hadoop/cdp/keytabs/etl_user.keytab"
      spark.kerberos.principal: "etl_user@AIDA.COM"
      spark.executorEnv.PYTHONPATH: "/opt/cloudera/parcels/SPARK3/lib/spark3/python:/opt/cloudera/parcels/SPARK3/lib/spark3/python/lib/py4j-0.10.9.7-src.zip"

# =============================================================================
# DATABASE CONNECTIONS (Auto-detected from XML)
# =============================================================================
connections:
  oracle-defaults: &oracle
    type: "oracle"
    host: 192.168.55.107
    port: 1521
    service_name: "CDCUATPDB"
    username: "pyspark"
    schema: "pyspark"
    password: "credential:connections.oracle-pyspark.password"
    driver: "oracle.jdbc.driver.OracleDriver"

{% for conn_name, conn_info in db_connections.items() %}
  {{ conn_name }}:
    <<: *oracle
    {% if conn_info.type == 'flatfile' or not conn_info.database %}
    database: "{{ conn_info.database or conn_name }}"
    {% else %}
    database: "{{ conn_info.database }}"
    {% endif %}
{% endfor %}

  # Fallback connections for mapplet lookups and unresolved connection aliases.
  # Override host/port/service_name/database as needed for your environment.
  source_db:
    <<: *oracle
  target_db:
    <<: *oracle
  target:
    <<: *oracle
  source:
    <<: *oracle
  lookup_conn:
    <<: *oracle

# =============================================================================
# VALIDATION PROFILE (Optional — for source-vs-target comparison)
# =============================================================================
# The validation framework compares:
#   source = base connections + validation.connections overrides
#   target = base connections (unchanged)
# These fields override the base connection when querying the Informatica source database.  
# The base connection is used as-is for PySpark queries.
validation:
  connections:
    host: 192.168.55.107
    port: 1521
    username: "informatica"
    schema: "informatica"
    password: "credential:connections.oracle-informatica.password"

# =============================================================================
# FILE PATH ROOT DIRECTORIES
# =============================================================================
# These paths serve as root directories for file source objects.
# Override via environment variables or modify the defaults below.
paths:
  source_file_dir: "{{ paths.source_file_dir }}"
  target_file_dir: "{{ paths.target_file_dir }}"

# =============================================================================
# FILE OBJECTS (Only file-type objects; database tables use connections directly)
# =============================================================================
objects:
{% for table_name, table_info in tables.items() %}
  {%- set is_file_object = (table_info.type == 'source' and table_info.connection in ['UTL', 'flatfile']) or table_info.get('is_flat_file', False) %}
  {%- if is_file_object %}
  
  {{ table_name }}:
    format: "csv"
    path: "{{ table_info.get('path', '/var/lib/airflow/dags/' + table_name) | replace('__SOURCE_FILE_DIR__', paths.source_file_dir_ref) }}"
    delimiter: "{{ table_info.get('delimiter', ',') }}"
    header: "{{ table_info.get('header', 'true') }}"
  {%- endif %}
{% endfor %}

# =============================================================================
# MAPPING VARIABLES
# =============================================================================
variables:
{% for var_name, var_info in mapping_variables.items() %}
  {{ var_name }}:
    datatype: "{{ var_info.datatype }}"
    default_value: "{{ var_info.default_value }}"
{% endfor %}

logging:
  dir: "logs"
  level: INFO
  backup_count: 7

# =============================================================================
# MAPPING-SPECIFIC RULES
# =============================================================================
rules:
  date_format: "yyyy-MM-dd"
  timestamp_format: "yyyy-MM-dd HH:mm:ss"
  decimal_precision: 38
  decimal_scale: 10
  string_max_length: 4000
  batch_size: 10000

# =============================================================================
# EMAIL NOTIFICATIONS
# =============================================================================
email:
  mail_to: "asl@aidacdp04.bda.com"
  mail_from: "noreply@example.com"
  smtp_host: "192.168.55.104"
  smtp_port: "25"
