# Configuration for PySpark Job
# Auto-generated by ASL Informatica XML to PySpark Converter
# Generated from: {{ mapping_name }}

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
environment:
  name: ${ENV_NAME:development}
  log_level: ${LOG_LEVEL:INFO}
  
# =============================================================================
# SPARK CONFIGURATION
# =============================================================================
spark:
  app_name: "{{ mapping_name }}"
  master: ${SPARK_MASTER:local[*]}
  config:
    spark.ui.port: "4040"
    spark.driver.memory: "16g"
    spark.executor.memory: "16g"
    spark.sql.shuffle.partitions: "50"
    spark.default.parallelism: "50"
    spark.sql.debug.maxToStringFields: "100"
    spark.driver.maxResultSize: "8g"
    spark.sql.autoBroadcastJoinThreshold: "-1"
    spark.memory.fraction: "0.8"
    spark.memory.storageFraction: "0.3"
    spark.dynamicAllocation.enabled: "true"
    spark.shuffle.service.enabled: "true"
    spark.sql.adaptive.enabled: "true"

# =============================================================================
# DATABASE CONNECTIONS (Auto-detected from XML)
# =============================================================================
connections:
{% for conn_name, conn_info in db_connections.items() %}
  {{ conn_name }}:
    type: "{{ conn_info.type }}"
    host: "${DB_HOST}"
    port: {{ conn_info.port }}
    database: "{{ conn_info.database }}"
    username: "${DB_USER}"
    password: "${DB_PASSWORD}"
    schema: "{{ conn_info.schema }}"
    driver: "{{ conn_info.driver }}"
{% endfor %}

# =============================================================================
# FILE PATHS
# =============================================================================
paths:
  input_base: "${INPUT_PATH:/data/input}"
  output_base: "${OUTPUT_PATH:/data/output}"
  staging: "${STAGING_PATH:/data/staging}"
  archive: "${ARCHIVE_PATH:/data/archive}"

# =============================================================================
# SOURCE/TARGET TABLE DEFINITIONS
# =============================================================================
tables:
{% for table_name, table_info in tables.items() %}
  {%- set rendered_name = table_name + ('_target' if table_info.type != 'source' else '') -%}
  {{ rendered_name }}:
    connection: "{{ table_info.connection }}"
    database: "{{ table_info.database }}"
    schema: "{{ table_info.schema }}"
    type: "{{ table_info.type }}"

{% endfor %}

# =============================================================================
# MAPPING VARIABLES
# =============================================================================
variables:
{% for var_name, var_info in mapping_variables.items() %}
  {{ var_name }}:
    datatype: "{{ var_info.datatype }}"
    default_value: "{{ var_info.default_value }}"
{% endfor %}

# =============================================================================
# CONVERSION OPTIONS
# =============================================================================
options:
  use_delta_format: true
  broadcast_lookups: true
  enable_schema_evolution: true
  enable_metrics: true

# =============================================================================
# MAPPING-SPECIFIC RULES
# =============================================================================
rules:
  date_format: "yyyy-MM-dd"
  timestamp_format: "yyyy-MM-dd HH:mm:ss"
  decimal_precision: 38
  decimal_scale: 10
  string_max_length: 4000
  batch_size: 10000
