# Configuration for PySpark Job
# Auto-generated by Informatica XML to PySpark Converter
# Generated from: {{ mapping_name }}

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
environment:
  name: ${ENV_NAME:development}
  log_level: ${LOG_LEVEL:INFO}
  
# =============================================================================
# SPARK CONFIGURATION (Matching Reference Code Settings)
# =============================================================================
spark:
  app_name: "{{ mapping_name }}"
  master: ${SPARK_MASTER:local[*]}
  config:
    spark.ui.port: "4040"
    spark.driver.extraClassPath: "${MSSQL_DRIVER_JAR:/opt/drivers/mssql-jdbc-12.4.2.jre11.jar}"
    spark.executor.extraClassPath: "${MSSQL_DRIVER_JAR:/opt/drivers/mssql-jdbc-12.4.2.jre11.jar}"
    spark.driver.memory: "16g"
    spark.executor.memory: "16g"
    spark.memory.offHeap.enabled: "true"
    spark.memory.offHeap.size: "16g"
    spark.sql.shuffle.partitions: "50"
    spark.default.parallelism: "50"
    spark.sql.debug.maxToStringFields: "100"
    spark.driver.maxResultSize: "8g"
    spark.sql.autoBroadcastJoinThreshold: "-1"
    spark.memory.fraction: "0.8"
    spark.memory.storageFraction: "0.3"
    spark.dynamicAllocation.enabled: "true"
    spark.shuffle.service.enabled: "true"
    spark.sql.extensions: "io.delta.sql.DeltaSparkSessionExtension"
    spark.sql.catalog.spark_catalog: "org.apache.spark.sql.delta.catalog.DeltaCatalog"
    spark.sql.adaptive.enabled: "true"
    spark.databricks.delta.optimizeWrite.enabled: "true"
    spark.databricks.delta.autoCompact.enabled: "true"

# =============================================================================
# DATABASE CONNECTIONS (All MSSQL)
# Connection to Database Mapping (Priority: Connection Name > XML Database Name)
# CDM_PRE_LANDING     -> msscdm_dev
# CDM_PRE_LANDING_INV -> msscdm_inv
# CDM_LANDING         -> cmx_ors_10_3
# CDM_LANDING_INV     -> cmx_ors_inv
# TARGET (Fixed)      -> msscdm_dev3
# =============================================================================
connections:
  # Pre-Landing Source Connection (MSSQL)
  CDM_PRE_LANDING:
    db_type: "sqlserver"
    jdbc_url: "jdbc:sqlserver://${MSSQL_HOST};databaseName=msscdm_dev;user=${MSSQL_USER};password=${MSSQL_PASSWORD};trustServerCertificate=true;encrypt=false"
    host: "${MSSQL_HOST}"
    database: "msscdm_dev"
    user: "${MSSQL_USER}"
    password: "${MSSQL_PASSWORD}"
    driver: "com.microsoft.sqlserver.jdbc.SQLServerDriver"
    driver_jar: "${MSSQL_DRIVER_JAR:/opt/drivers/mssql-jdbc-12.4.2.jre11.jar}"
  
  # Pre-Landing Inventory Connection (MSSQL)
  CDM_PRE_LANDING_INV:
    db_type: "sqlserver"
    jdbc_url: "jdbc:sqlserver://${MSSQL_HOST};databaseName=msscdm_inv;user=${MSSQL_USER};password=${MSSQL_PASSWORD};trustServerCertificate=true;encrypt=false"
    host: "${MSSQL_HOST}"
    database: "msscdm_inv"
    user: "${MSSQL_USER}"
    password: "${MSSQL_PASSWORD}"
    driver: "com.microsoft.sqlserver.jdbc.SQLServerDriver"
    driver_jar: "${MSSQL_DRIVER_JAR:/opt/drivers/mssql-jdbc-12.4.2.jre11.jar}"
  
  # Landing Source Connection (MSSQL)
  CDM_LANDING:
    db_type: "sqlserver"
    jdbc_url: "jdbc:sqlserver://${MSSQL_HOST};databaseName=cmx_ors_10_3;user=${MSSQL_USER};password=${MSSQL_PASSWORD};trustServerCertificate=true;encrypt=false"
    host: "${MSSQL_HOST}"
    database: "cmx_ors_10_3"
    user: "${MSSQL_USER}"
    password: "${MSSQL_PASSWORD}"
    driver: "com.microsoft.sqlserver.jdbc.SQLServerDriver"
    driver_jar: "${MSSQL_DRIVER_JAR:/opt/drivers/mssql-jdbc-12.4.2.jre11.jar}"
  
  # Landing Inventory Source Connection (MSSQL)
  CDM_LANDING_INV:
    db_type: "sqlserver"
    jdbc_url: "jdbc:sqlserver://${MSSQL_HOST};databaseName=cmx_ors_inv;user=${MSSQL_USER};password=${MSSQL_PASSWORD};trustServerCertificate=true;encrypt=false"
    host: "${MSSQL_HOST}"
    database: "cmx_ors_inv"
    user: "${MSSQL_USER}"
    password: "${MSSQL_PASSWORD}"
    driver: "com.microsoft.sqlserver.jdbc.SQLServerDriver"
    driver_jar: "${MSSQL_DRIVER_JAR:/opt/drivers/mssql-jdbc-12.4.2.jre11.jar}"
  
  # Fixed Target Connection (MSSQL) - Always msscdm_dev3
  TARGET:
    db_type: "sqlserver"
    jdbc_url: "jdbc:sqlserver://${MSSQL_HOST};databaseName=msscdm_dev3;user=${MSSQL_USER};password=${MSSQL_PASSWORD};trustServerCertificate=true;encrypt=false"
    host: "${MSSQL_HOST}"
    database: "msscdm_dev3"
    user: "${MSSQL_USER}"
    password: "${MSSQL_PASSWORD}"
    driver: "com.microsoft.sqlserver.jdbc.SQLServerDriver"
    driver_jar: "${MSSQL_DRIVER_JAR:/opt/drivers/mssql-jdbc-12.4.2.jre11.jar}"

# =============================================================================
# FILE PATHS
# =============================================================================
paths:
  input_base: "${INPUT_PATH:/data/input}"
  output_base: "${OUTPUT_PATH:/data/output}"
  checkpoint: "${CHECKPOINT_PATH:/data/checkpoints}"
  staging: "${STAGING_PATH:/data/staging}"
  archive: "${ARCHIVE_PATH:/data/archive}"

# Cloud storage configuration
cloud_storage:
  provider: "${CLOUD_PROVIDER:azure}"  # azure, aws, gcp
  container: "${STORAGE_CONTAINER}"
  account: "${STORAGE_ACCOUNT}"

# =============================================================================
# SOURCE CONFIGURATION
# =============================================================================
sources:
{% if user_config and user_config.sources %}
{% for source in user_config.sources %}
  {{ source.source_name }}:
    type: "{{ source.source_type.value if source.source_type else 'SQL' }}"
{% if source.connection_alias %}
    connection: "{{ source.connection_alias }}"
{% endif %}
{% if source.file_path %}
    path: "{{ source.file_path }}"
    format: "{{ source.file_format.value if source.file_format else 'csv' }}"
    location: "{{ source.file_location.value if source.file_location else 'local' }}"
{% endif %}
{% if source.delimiter %}
    delimiter: "{{ source.delimiter }}"
{% endif %}
    header: {{ 'true' if source.header else 'false' }}
{% endfor %}
{% else %}
  # Sources will be configured based on mapping analysis
  default_source:
    type: "SQL"
    connection: "source_db"
{% endif %}

# =============================================================================
# TARGET CONFIGURATION
# =============================================================================
targets:
{% if user_config and user_config.targets %}
{% for target in user_config.targets %}
  {{ target.target_name }}:
    format: "{{ target.output_format }}"
    mode: "{{ target.write_mode }}"
{% if target.destination_path %}
    path: "{{ target.destination_path }}"
{% endif %}
{% if target.table_name %}
    table: "{{ target.table_name }}"
{% endif %}
{% endfor %}
{% else %}
  # Targets will be configured based on mapping analysis
  default_target:
    format: "delta"
    mode: "append"
    path: "${OUTPUT_PATH}/default_output"
{% endif %}

# =============================================================================
# CONVERSION OPTIONS / FEATURE FLAGS
# =============================================================================
options:
  use_delta_format: {{ user_config.options.use_delta_format if user_config and user_config.options else 'true' }}
  broadcast_lookups: {{ user_config.options.broadcast_lookups if user_config and user_config.options else 'true' }}
  generate_tests: {{ user_config.options.generate_tests if user_config and user_config.options else 'false' }}
  enable_schema_evolution: true
  enable_metrics: true
  
# Data quality settings
data_quality:
  enable_validation: true
  null_handling: "coalesce"  # coalesce, filter, error
  type_mismatch: "cast"      # cast, error, skip

# =============================================================================
# MAPPING-SPECIFIC RULES
# =============================================================================
rules:
  date_format: "yyyy-MM-dd"
  timestamp_format: "yyyy-MM-dd HH:mm:ss"
  decimal_precision: 38
  decimal_scale: 10
  string_max_length: 4000
  batch_size: 10000
