# Configuration for {{ mapping_name }}
# Auto-generated by ASL Informatica XML to PySpark Converter

connections:
{% for conn_name, conn_config in user_config.db_connections.items() %}
  {{ conn_name }}:
{% for key, value in conn_config.items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% else %}
  default_db:
    type: "sqlserver"
    host: "${DB_HOST}"
    port: 1433
    database: "database_name"
    user: "${DB_USER}"
    password: "${DB_PASSWORD}"
    driver: "com.microsoft.sqlserver.jdbc.SQLServerDriver"
{% endfor %}

sources:
{% for source_config in user_config.sources %}
  {{ source_config.source_name }}:
    type: "{{ source_config.source_type.value }}"
{% if source_config.connection_alias %}
    connection: "{{ source_config.connection_alias }}"
{% endif %}
{% if source_config.file_path %}
    path: "{{ source_config.file_path }}"
{% endif %}
{% if source_config.file_format %}
    format: "{{ source_config.file_format.value }}"
{% endif %}
{% if source_config.file_location %}
    location: "{{ source_config.file_location.value }}"
{% endif %}
{% if source_config.source_type.value == "FILE" %}
    options:
      delimiter: "{{ source_config.delimiter }}"
      header: {{ source_config.header | lower }}
      quote: "{{ source_config.quote_char }}"
      encoding: "{{ source_config.encoding }}"
{% endif %}
{% else %}
  # No sources configured
{% endfor %}

targets:
{% for target_config in user_config.targets %}
  {{ target_config.target_name }}:
    format: "{{ target_config.output_format }}"
    path: "{{ target_config.destination_path }}"
    table: "{{ target_config.table_name }}"
    mode: "{{ target_config.write_mode }}"
{% else %}
  # No targets configured
{% endfor %}

# Spark configuration
spark:
  app_name: "{{ mapping_name }}"
  master: "local[*]"
  config:
    spark.sql.adaptive.enabled: true
    spark.sql.adaptive.coalescePartitions.enabled: true
