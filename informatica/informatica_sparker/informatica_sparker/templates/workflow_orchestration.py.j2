def get_spark_session(app_name: str, config: Dict = None) -> SparkSession:
    """Create or get SparkSession with configuration."""
    builder = SparkSession.builder.appName(app_name)
    
    if config and "spark" in config:
        spark_config = config["spark"]
        if "master" in spark_config:
            builder = builder.master(spark_config["master"])
        if "configs" in spark_config:
            for key, value in spark_config["configs"].items():
                builder = builder.config(key, str(value))
    
    return builder.getOrCreate()


def load_config(config_path: str = "config.yml") -> Dict[str, Any]:
    """Load configuration from YAML file with environment variable substitution."""
    if not os.path.exists(config_path):
        return {}
    
    with open(config_path, "r") as f:
        content = f.read()
    
    for key, value in os.environ.items():
        content = content.replace(f"${{{key}}}", value)
        content = content.replace(f"${key}", value)
    
    return yaml.safe_load(content) or {}


def setup_logging(level: int = logging.INFO) -> logging.Logger:
    """Setup logging configuration."""
    logging.basicConfig(
        level=level,
        format="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
    )
    return logging.getLogger("{{ workflow_name }}")


class SparkContext:
    """Context holder for Spark session, config, and registered DataFrames."""
    
    def __init__(self, spark, config: Dict[str, Any]):
        self.spark = spark
        self.config = config
        self.dataframes: Dict[str, Any] = {}
        self.logger = logging.getLogger(self.__class__.__name__)
    
    def get_connection(self, name: str) -> Dict[str, Any]:
        """Get connection configuration by name."""
        return self.config.get("connections", {}).get(name, {})
    
    def register_df(self, name: str, df):
        """Register a DataFrame for later reference."""
        self.dataframes[name] = df
    
    def get_df(self, name: str):
        """Get a registered DataFrame by name."""
        return self.dataframes.get(name)
    
    def get_param(self, key: str, default: Any = None) -> Any:
        """Get a parameter from config."""
        return self.config.get("parameters", {}).get(key, default)


class MappingMetrics:
    """Track metrics for a mapping execution."""
    
    def __init__(self, mapping_name: str):
        self.mapping_name = mapping_name
        self.start_time: Optional[datetime] = None
        self.end_time: Optional[datetime] = None
        self.row_counts: Dict[str, int] = {}
        self.warnings: List[str] = []
        self.status: str = "PENDING"
        self.error: Optional[str] = None
        self.logger = logging.getLogger(f"Metrics.{mapping_name}")
    
    def start(self):
        """Mark mapping start."""
        self.start_time = datetime.now()
        self.status = "RUNNING"
        self.logger.info(f"Started mapping: {self.mapping_name}")
    
    def complete(self):
        """Mark mapping completion."""
        self.end_time = datetime.now()
        self.status = "SUCCESS"
        duration = (self.end_time - self.start_time).total_seconds() if self.start_time else 0
        self.logger.info(f"Completed mapping: {self.mapping_name} in {duration:.2f}s")
    
    def fail(self, error: Exception):
        """Mark mapping failure."""
        self.end_time = datetime.now()
        self.status = "FAILED"
        self.error = str(error)
        self.logger.error(f"Failed mapping: {self.mapping_name} - {error}")
    
    def log_row_count(self, step_name: str, count: int):
        """Log row count for a step."""
        self.row_counts[step_name] = count
        self.logger.debug(f"Step {step_name}: {count} rows")
    
    def add_warning(self, warning: str):
        """Add a warning message."""
        self.warnings.append(warning)
        self.logger.warning(f"{self.mapping_name}: {warning}")
    
    def get_summary(self) -> Dict[str, Any]:
        """Get metrics summary."""
        duration = None
        if self.start_time and self.end_time:
            duration = (self.end_time - self.start_time).total_seconds()
        
        return {
            "mapping_name": self.mapping_name,
            "status": self.status,
            "start_time": self.start_time.isoformat() if self.start_time else None,
            "end_time": self.end_time.isoformat() if self.end_time else None,
            "duration_seconds": duration,
            "row_counts": self.row_counts,
            "warnings": self.warnings,
            "error": self.error
        }


class WorkflowMetrics:
    """Track metrics for entire workflow execution."""
    
    def __init__(self, workflow_name: str):
        self.workflow_name = workflow_name
        self.start_time: Optional[datetime] = None
        self.end_time: Optional[datetime] = None
        self.mapping_metrics: Dict[str, MappingMetrics] = {}
        self.status: str = "PENDING"
        self.logger = logging.getLogger(f"WorkflowMetrics.{workflow_name}")
    
    def start(self):
        """Mark workflow start."""
        self.start_time = datetime.now()
        self.status = "RUNNING"
        self.logger.info(f"Started workflow: {self.workflow_name}")
    
    def complete(self):
        """Mark workflow completion."""
        self.end_time = datetime.now()
        self.status = "SUCCESS"
        duration = (self.end_time - self.start_time).total_seconds() if self.start_time else 0
        self.logger.info(f"Completed workflow: {self.workflow_name} in {duration:.2f}s")
    
    def fail(self):
        """Mark workflow failure."""
        self.end_time = datetime.now()
        self.status = "FAILED"
        self.logger.error(f"Failed workflow: {self.workflow_name}")
    
    def create_mapping_metrics(self, mapping_name: str) -> MappingMetrics:
        """Create metrics tracker for a mapping."""
        metrics = MappingMetrics(mapping_name)
        self.mapping_metrics[mapping_name] = metrics
        return metrics
    
    def get_summary(self) -> Dict[str, Any]:
        """Get workflow metrics summary."""
        duration = None
        if self.start_time and self.end_time:
            duration = (self.end_time - self.start_time).total_seconds()
        
        return {
            "workflow_name": self.workflow_name,
            "status": self.status,
            "start_time": self.start_time.isoformat() if self.start_time else None,
            "end_time": self.end_time.isoformat() if self.end_time else None,
            "duration_seconds": duration,
            "mappings": {
                name: m.get_summary() 
                for name, m in self.mapping_metrics.items()
            }
        }


logger = setup_logging()


# =============================================================================
# WORKFLOW DAG DEFINITION
# =============================================================================

WORKFLOW_DAG = {
    "workflow_name": "{{ workflow_name }}",
    "sessions": {{ sessions | tojson }},
    "dependencies": {{ dependencies | tojson }},
    "execution_order": {{ execution_order | tojson }}
}


def get_execution_order() -> List[str]:
    """Get the ordered list of sessions to execute based on dependencies."""
    return WORKFLOW_DAG["execution_order"]


def get_session_dependencies(session_name: str) -> List[str]:
    """Get dependencies for a specific session."""
    return WORKFLOW_DAG["dependencies"].get(session_name, [])


def execute_session(session_name: str, ctx: SparkContext, 
                    workflow_metrics: WorkflowMetrics) -> bool:
    """
    Execute a single session (mapping).
    
    Args:
        session_name: Name of the session to execute
        ctx: SparkContext with configuration
        workflow_metrics: Workflow metrics tracker
    
    Returns:
        bool: True if successful, False otherwise
    """
    session_info = next(
        (s for s in WORKFLOW_DAG["sessions"] if s["name"] == session_name), 
        None
    )
    
    if not session_info:
        logger.error(f"Session '{session_name}' not found in workflow")
        return False
    
    mapping_name = session_info.get("mapping_name", session_name)
    metrics = workflow_metrics.create_mapping_metrics(mapping_name)
    
    logger.info(f"Executing session: {session_name} (mapping: {mapping_name})")
    
    mapping_functions = {
        {% for mapping in mappings %}
        "{{ mapping.name }}": run_{{ mapping.safe_name }},
        {% endfor %}
    }
    
    run_func = mapping_functions.get(mapping_name)
    if run_func:
        try:
            return run_func(ctx, metrics)
        except Exception as e:
            logger.error(f"Session '{session_name}' failed: {e}")
            return False
    else:
        logger.warning(f"No mapping function found for '{mapping_name}'")
        return True


def check_dependencies_completed(session_name: str, 
                                 completed_sessions: set) -> bool:
    """Check if all dependencies for a session are completed."""
    deps = get_session_dependencies(session_name)
    return all(dep in completed_sessions for dep in deps)


def run_workflow(config: Dict[str, Any] = None, 
                 fail_fast: bool = True) -> Dict[str, Any]:
    """
    Execute the entire workflow in dependency order.
    
    Args:
        config: Optional configuration override
        fail_fast: Stop on first failure if True
    
    Returns:
        dict: Workflow execution results
    """
    if config is None:
        config = load_config("config.yml")
    
    spark = get_spark_session("{{ workflow_name }}", config)
    ctx = SparkContext(spark, config)
    
    workflow_metrics = WorkflowMetrics("{{ workflow_name }}")
    workflow_metrics.start()
    
    completed_sessions = set()
    failed_sessions = set()
    results = {}
    
    try:
        execution_order = get_execution_order()
        
        for session_name in execution_order:
            if not check_dependencies_completed(session_name, completed_sessions):
                deps = get_session_dependencies(session_name)
                failed_deps = [d for d in deps if d in failed_sessions]
                if failed_deps:
                    logger.error(f"Skipping '{session_name}' due to failed dependencies: {failed_deps}")
                    failed_sessions.add(session_name)
                    results[session_name] = {"status": "SKIPPED", "reason": f"Failed dependencies: {failed_deps}"}
                    continue
            
            success = execute_session(session_name, ctx, workflow_metrics)
            
            if success:
                completed_sessions.add(session_name)
                results[session_name] = {"status": "SUCCESS"}
            else:
                failed_sessions.add(session_name)
                results[session_name] = {"status": "FAILED"}
                
                if fail_fast:
                    logger.error(f"Workflow stopped due to failure in '{session_name}'")
                    break
        
        if failed_sessions:
            workflow_metrics.fail()
        else:
            workflow_metrics.complete()
        
        return {
            "workflow_name": "{{ workflow_name }}",
            "status": "FAILED" if failed_sessions else "SUCCESS",
            "completed": list(completed_sessions),
            "failed": list(failed_sessions),
            "results": results,
            "metrics": workflow_metrics.get_summary()
        }
        
    finally:
        spark.stop()


def run_single_mapping(mapping_name: str, config: Dict[str, Any] = None) -> bool:
    """
    Execute a single mapping without the full workflow.
    Useful for testing or re-running a specific mapping.
    
    Args:
        mapping_name: Name of the mapping to execute
        config: Optional configuration override
    
    Returns:
        bool: True if successful
    """
    if config is None:
        config = load_config("config.yml")
    
    spark = get_spark_session(mapping_name, config)
    ctx = SparkContext(spark, config)
    
    workflow_metrics = WorkflowMetrics(f"single_{mapping_name}")
    workflow_metrics.start()
    
    try:
        mapping_functions = {
            {% for mapping in mappings %}
            "{{ mapping.name }}": run_{{ mapping.safe_name }},
            {% endfor %}
        }
        
        run_func = mapping_functions.get(mapping_name)
        if run_func:
            metrics = workflow_metrics.create_mapping_metrics(mapping_name)
            success = run_func(ctx, metrics)
            workflow_metrics.complete()
            return success
        else:
            logger.error(f"Mapping '{mapping_name}' not found")
            return False
    finally:
        spark.stop()


def main():
    """Main entry point for workflow execution."""
    import argparse
    
    parser = argparse.ArgumentParser(description="{{ workflow_name }} Workflow Orchestration")
    parser.add_argument("--mapping", "-m", help="Run specific mapping only")
    parser.add_argument("--config", "-c", default="config.yml", help="Config file path")
    parser.add_argument("--fail-fast", action="store_true", default=True, 
                       help="Stop on first failure")
    parser.add_argument("--continue-on-error", action="store_true",
                       help="Continue execution even if a mapping fails")
    
    args = parser.parse_args()
    
    config = load_config(args.config)
    
    if args.mapping:
        success = run_single_mapping(args.mapping, config)
        return 0 if success else 1
    else:
        fail_fast = not args.continue_on_error
        result = run_workflow(config, fail_fast=fail_fast)
        
        print("\n" + "="*60)
        print(f"WORKFLOW RESULT: {result['status']}")
        print("="*60)
        print(f"Completed: {len(result['completed'])} sessions")
        print(f"Failed: {len(result['failed'])} sessions")
        
        if result['failed']:
            print(f"\nFailed sessions: {result['failed']}")
        
        return 0 if result['status'] == "SUCCESS" else 1


if __name__ == "__main__":
    sys.exit(main())
