def get_jdbc_url(config: Dict[str, Any]) -> str:
    """Build JDBC URL from connection configuration."""
    db_type = config.get("db_type", "sqlserver").lower()
    
    if config.get("jdbc_url"):
        return config["jdbc_url"]
    
    host = config.get("host", "localhost")
    port = config.get("port", 1433)
    database = config.get("database", "")
    schema = config.get("schema", "")
    
    if db_type in ["sqlserver", "mssql", "microsoft sql server"]:
        url = f"jdbc:sqlserver://{host}:{port};databaseName={database}"
        if schema:
            url += f";schema={schema}"
        return url
    elif db_type == "oracle":
        return f"jdbc:oracle:thin:@{host}:{port}:{database}"
    elif db_type == "postgresql":
        return f"jdbc:postgresql://{host}:{port}/{database}"
    elif db_type == "mysql":
        return f"jdbc:mysql://{host}:{port}/{database}"
    else:
        return f"jdbc:{db_type}://{host}:{port}/{database}"


def get_jdbc_driver(db_type: str) -> str:
    """Get JDBC driver class for database type."""
    drivers = {
        "sqlserver": "com.microsoft.sqlserver.jdbc.SQLServerDriver",
        "mssql": "com.microsoft.sqlserver.jdbc.SQLServerDriver",
        "oracle": "oracle.jdbc.driver.OracleDriver",
        "postgresql": "org.postgresql.Driver",
        "mysql": "com.mysql.cj.jdbc.Driver"
    }
    return drivers.get(db_type.lower(), "com.microsoft.sqlserver.jdbc.SQLServerDriver")


def read_sql(spark: SparkSession, conn_config: Dict[str, Any], 
             table: str = None, query: str = None) -> DataFrame:
    """Read data from SQL database."""
    jdbc_url = get_jdbc_url(conn_config)
    user = conn_config.get("user", "${DB_USER}")
    password = conn_config.get("password", "${DB_PASSWORD}")
    driver = conn_config.get("driver") or get_jdbc_driver(conn_config.get("db_type", "sqlserver"))
    
    reader = spark.read.format("jdbc") \
        .option("url", jdbc_url) \
        .option("user", user) \
        .option("password", password) \
        .option("driver", driver)
    
    if query:
        reader = reader.option("dbtable", f"({query}) AS subquery")
    elif table:
        reader = reader.option("dbtable", table)
    else:
        raise ValueError("Either table or query must be provided")
    
    return reader.load()


