    def start(self):
        """Start workflow tracking."""
        self.start_time = datetime.now()
        self.status = "RUNNING"
        logger.info(f"=== Workflow '{self.workflow_name}' started ===")
    
    def complete(self):
        """Complete workflow tracking."""
        self.end_time = datetime.now()
        failed = [m for m in self.mapping_metrics.values() if m.status == "FAILED"]
        self.status = "FAILED" if failed else "COMPLETED"
        duration = (self.end_time - self.start_time).total_seconds()
        logger.info(f"=== Workflow '{self.workflow_name}' {self.status} in {duration:.2f}s ===")
    
    def create_mapping_metrics(self, mapping_name: str) -> MappingMetrics:
        """Create metrics tracker for a mapping."""
