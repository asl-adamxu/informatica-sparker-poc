def merge_into_delta(spark: SparkSession, source_df: DataFrame, 
                     target_path: str, merge_keys: List[str],
                     update_cols: List[str] = None,
                     insert_cols: List[str] = None,
                     delete_condition: str = None) -> None:
    """
    Merge source DataFrame into Delta table.
    Supports INSERT, UPDATE, and DELETE operations.
    """
    from delta.tables import DeltaTable
    
    if DeltaTable.isDeltaTable(spark, target_path):
        delta_tbl = DeltaTable.forPath(spark, target_path)
        
        merge_cond = " AND ".join([f"t.{k} = s.{k}" for k in merge_keys])
        
        merger = delta_tbl.alias("t").merge(
            source_df.alias("s"),
            merge_cond
        )
        
        if delete_condition:
            merger = merger.whenMatchedDelete(condition=delete_condition)
        
        if update_cols:
            update_dict = {c: col(f"s.{c}") for c in update_cols}
            merger = merger.whenMatchedUpdate(set=update_dict)
        else:
            merger = merger.whenMatchedUpdateAll()
        
        if insert_cols:
            insert_dict = {c: col(f"s.{c}") for c in insert_cols}
            merger = merger.whenNotMatchedInsert(values=insert_dict)
        else:
            merger = merger.whenNotMatchedInsertAll()
        
        merger.execute()
    else:
        source_df.write.format("delta").save(target_path)


