def scd_type2_merge(spark: SparkSession, source_df: DataFrame,
                    target_path: str, key_cols: List[str],
                    compare_cols: List[str], 
                    effective_date_col: str = "effective_date",
                    end_date_col: str = "end_date",
                    current_flag_col: str = "is_current") -> None:
    """
    Apply SCD Type 2 logic for slowly changing dimensions.
    """
    from delta.tables import DeltaTable
    
    source_with_dates = source_df \
        .withColumn(effective_date_col, current_date()) \
        .withColumn(end_date_col, lit(None).cast("date")) \
        .withColumn(current_flag_col, lit(True))
    
    if not DeltaTable.isDeltaTable(spark, target_path):
        source_with_dates.write.format("delta").save(target_path)
        return
    
    delta_tbl = DeltaTable.forPath(spark, target_path)
    
    key_cond = " AND ".join([f"t.{k} = s.{k}" for k in key_cols])
    change_cond = " OR ".join([f"t.{c} != s.{c}" for c in compare_cols])
    merge_cond = f"{key_cond} AND t.{current_flag_col} = true"
    
    source_cols = source_with_dates.columns
    insert_dict = {c: col(f"s.{c}") for c in source_cols}
    
    delta_tbl.alias("t").merge(
        source_with_dates.alias("s"),
        merge_cond
    ).whenMatchedUpdate(
        condition=change_cond,
        set={
            end_date_col: current_date(),
            current_flag_col: lit(False)
        }
    ).whenNotMatchedInsertAll().execute()
    
    new_records = source_with_dates.alias("s").join(
        delta_tbl.toDF().filter(col(current_flag_col) == False).alias("t"),
        [col(f"s.{k}") == col(f"t.{k}") for k in key_cols],
        "inner"
    ).select([col(f"s.{c}") for c in source_cols])
    
    new_records.write.format("delta").mode("append").save(target_path)


def optimize_delta_table(spark: SparkSession, target_path: str,
                         z_order_cols: List[str] = None) -> None:
    """Optimize Delta table with optional Z-ORDER."""
    from delta.tables import DeltaTable
    
    if DeltaTable.isDeltaTable(spark, target_path):
        if z_order_cols:
            spark.sql(f"OPTIMIZE delta.`{target_path}` ZORDER BY ({', '.join(z_order_cols)})")
        else:
            spark.sql(f"OPTIMIZE delta.`{target_path}`")


def vacuum_delta_table(spark: SparkSession, target_path: str,
                       retention_hours: int = 168) -> None:
    """Vacuum Delta table to remove old files."""
    from delta.tables import DeltaTable
    
    if DeltaTable.isDeltaTable(spark, target_path):
        delta_tbl = DeltaTable.forPath(spark, target_path)
        delta_tbl.vacuum(retention_hours)
